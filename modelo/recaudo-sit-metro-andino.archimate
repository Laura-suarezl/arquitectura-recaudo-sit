    </element>
    <element xsi:type="archimate:Meaning" name="Consolidación: Valor consumido en validaciones → «Ingreso tarifario»" id="id-90414d7c8c6e62fdd5e25150">
      <property key="contexto" value="Consolidación"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Financiera (externo): Cálculo semanal de lo que corresponde a cada operador → «Liquidación de remuneración» (fuera del modelo)" id="id-3f6ce76b5d83cfa24c3cb388">
      <property key="contexto" value="Financiera (externo)"/>
