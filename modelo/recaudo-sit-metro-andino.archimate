      <documentation>Ejemplo: 50 viajes escolares al mes</documentation>
      <property key="contexto" value="Beneficiarios"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Tarjeta propia del SIT, anónima o personalizada, que identifica la cuenta de saldo del usuario" id="id-e093dbdfebbc9a9a441aacf6">
      <documentation>Ejemplo: VAMOS personalizada de Ana</documentation>
      <property key="contexto" value="Tarjetas VAMOS"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Persona asociada a una tarjeta VAMOS personalizada" id="id-3acd5e44f304a6f406f372a7">
      <documentation>Ejemplo: El titular pide el bloqueo</documentation>
      <property key="contexto" value="Tarjetas VAMOS"/>
    </element>
