      <property key="contexto" value="Jurídica (externo)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Tarjetas VAMOS: Valor disponible de la tarjeta en el sistema central → «Saldo»" id="id-d67129700ab73caea205cbac">
      <property key="contexto" value="Tarjetas VAMOS"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Validadores (externo): Valor grabado en el chip, que puede ir atrasado → «Saldo en chip»" id="id-9913cf54f18f19cca0d16d6a">
      <property key="contexto" value="Validadores (externo)"/>
