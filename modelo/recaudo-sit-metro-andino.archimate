    </element>
    <element xsi:type="archimate:Meaning" name="Tarifas · Validaciones: Valor que paga el usuario según su perfil → «Tarifa»" id="id-12f4e4da8996c744220de2a1">
      <property key="contexto" value="Tarifas · Validaciones"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Financiera (externo): Costo real por pasajero del sistema → «Tarifa técnica» (fuera del modelo)" id="id-3f6db359202d7b11738c9427">
      <property key="contexto" value="Financiera (externo)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Recargas · Tesorería: Dinero que entra por recargas y cobros bancarios → «Recaudo de caja»" id="id-435760f66a6c69371ae9b96c">
